{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/ui.schema.json",
  "web_ui": {
    "enabled": true,
    "adapter": "static_html",
    "kind": "output",
    "title": "Campaign planning report",
    "description": "Inspect the latest saved cycle, public source quotations and ideas awaiting review."
  },
  "starter_questions": [
    "What evidence will support a campaign idea?",
    "What does approving an idea allow?",
    "How do I connect the executor?"
  ],
  "init_config_review": {
    "required": true,
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ]
  },
  "setup_guide": {
    "schema": "otterdesk.setup_guide.v1",
    "introduction": "Start with the product website and the marketing goal. I’ll use public product evidence to draft one campaign idea for your review. You can connect the executor in Collaboration when you’re ready for a handoff.",
    "sample": {
      "available": false
    },
    "real": {
      "introduction": "Review your marketing settings and connect co-workers in Collaboration.",
      "values": {}
    },
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ],
    "prompt_file": "@/payloads/prompts/setup.md",
    "run_guidance": {
      "on_start": "I’ll check the public product sources so you can review the evidence behind a proposed campaign idea.",
      "output_ready": "Open the saved marketing status to check which ideas still need review.",
      "web_ui_ready": "Open the planning report and check the dated quotations behind the latest cycle."
    }
  }
}
